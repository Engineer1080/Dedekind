// bioinformatics_showcase.ddk — Bioinformatics and Cheminformatics Pipeline Showcase (v3.0.4)
//
// This showcase demonstrates the following features of Dedekind:
// 1. Compile-time Sequence Typing (DNA/RNA/Protein validation)
// 2. Automated Biochemical Unit Check & Scaling
// 3. Direct APIs: ChEMBL & PubChem queries
// 4. Differentiable Curve-Fitting (Hill/Michaelis-Menten) via built-in autograd
// 5. Automated PDF/HTML Notebook publishing of results

fn calculate_gc(seq: Sequence[DNA]) -> Scalar {
    return gc_content(seq)
}

fn main() {
    print("=========================================================")
    print("      DEDEKIND BIOINFORMATICS & CHEMINFORMATICS DEMO     ")
    print("=========================================================")
    print("")

    // 1. Central Dogma & Sequence Typing
    print("[1] NATIVE SEQUENCE TYPING")
    dna_input = "ATGGCCCTGTGGATGCGCCTCCTGCCCCTGCTGGCGCTGCTGGCC"
    print("DNA Input:      " + dna_input)
    print("Length (bp):    " + str(len(dna_input)))
    
    // Calculate GC content with Sequence[DNA] typechecking
    gc = calculate_gc(dna_input)
    print("GC Content:     " + str(gc * 100.0) + " %")
    
    // Transcribe to RNA and translate to Protein
    rna = transcribe(dna_input)
    protein = translate(rna)
    print("Transcribed:    " + rna)
    print("Translated:     " + protein)
    print("")

    // 2. Drug Databases APIs
    print("[2] DIRECT API QUERIES TO DRUG DATABASES")
    // Molecular formula of Aspirin via PubChem
    aspirin_formula = pubchem_get_molecular_formula("aspirin")
    print("PubChem: Aspirin Formula = " + aspirin_formula)
    
    // IC50 of Gefitinib vs EGFR target via ChEMBL
    ic50_val = chembl_get_ic50("EGFR", "gefitinib")
    print("ChEMBL: Gefitinib EGFR IC50 = " + str(ic50_val))
    print("")

    // 3. Unit Validation
    print("[3] BIOCHEMICAL UNIT VALIDATION & DILUTION")
    // Target concentration from ChEMBL data
    c_target = 0.0[nM] + ic50_val // 33 nM
    // Stock solution: 10 uM (Micromolar)
    c_stock = 10.0[uM]
    // Desired target volume: 50 mL
    v_target = 50.0[mL]
    
    // Dilution formula: V_stock = (C_target * V_target) / C_stock
    // Dedekind automatically scales uM, nM, and mL at compile-time!
    v_stock = (c_target * v_target) / c_stock
    
    print("Target Conc:        " + str(c_target))
    print("Stock Conc:         " + str(c_stock))
    print("Target Volume:      " + str(v_target))
    print("Required Stock Vol: " + str(v_stock) + " (equals " + str(0.0[uL] + v_stock) + ")")
    print("")

    // 4. Differentiable Fitting & Autograd
    print("[4] PARAMETER-FITTING OF A DOSE-RESPONSE CURVE (HILL / MICHAELIS-MENTEN)")
    // Synthetic experimental data (dose vs response)
    doses = [0.1, 0.5, 1.0, 2.0, 5.0, 10.0, 20.0]
    responses = [0.15, 0.6, 1.0, 1.6, 2.2, 2.6, 2.85]
    
    // L2 loss for MM fitting
    fn mm_loss(params, data) {
        x = data[0]
        y = data[1]
        Vmax = params[0]
        EC50 = params[1]
        y_pred = michaelis_menten(x, Vmax, EC50)
        diff = y_pred - y
        return (diff * diff).sum()
    }
    
    data_fit = [doses, responses]
    params_start = [3.0, 2.0]
    params_opt = fit(mm_loss, params_start, data_fit, method="gd", lr=0.01, steps=800)
    
    Vmax_fit = params_opt[0]
    EC50_fit = params_opt[1]
    
    print("Fitted Vmax:        " + str(Vmax_fit))
    print("Fitted EC50:        " + str(EC50_fit))
    print("")

    // 5. Visualisation
    print("[5] AUTOMATED VISUALIZATION")
    doses_fine = linspace(0.0, 20.0, 100)
    responses_fit = michaelis_menten(doses_fine, Vmax_fit, EC50_fit)
    
    // Generate Matplotlib plot
    scatter(doses, responses, title="Dose-Response Fit (Michaelis-Menten)", xlabel="Dose", ylabel="Response")
    plot(doses_fine, responses_fit)
    print("Plot generated successfully!")
    print("")
}
main()

// Export runnable script as interactive HTML notebook
export_notebook("examples/dedekind/chemistry_biology/bioinformatics_showcase.ddk", "examples/dedekind/chemistry_biology/bioinformatics_showcase.html", "html", "Dedekind Showcase: Bioinformatics & Drug Design")
